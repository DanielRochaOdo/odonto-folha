# Exemplo de nomes para G2. Nunca armazenar valores reais no Git.
# Disponibilizar DATABASE_URL apenas para apps/api (não NEXT_PUBLIC_*).
DATABASE_URL=
# Segredo real deve ser gerado e guardado em provedor de secrets.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Endpoint privado para roteamento servidor-servidor; configurar no G2.
API_INTERNAL_URL=
