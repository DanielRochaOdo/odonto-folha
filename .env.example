# OdontoFolha — MODELO SEM SEGREDOS
# Nunca coloque credenciais reais aqui, em commits, issues ou mensagens.
# Em produção, configure Environment Variables nos projetos Vercel corretos.
# Este monorepo separa apps/api e apps/web; variáveis não são compartilhadas automaticamente.

# =================== apps/api (Hono) ===================
# URL Neon POOLED (host normalmente contém -pooler). Usada em tráfego da aplicação.
DATABASE_URL=

# URL Neon DIRECT, sem -pooler: exclusivamente para migrações controladas,
# executadas em ambiente administrativo protegido, nunca no navegador.
DIRECT_URL=

# Gerar com "openssl rand -base64 32". Nunca usar senha do usuário ADMIN.
BETTER_AUTH_SECRET=

# URL pública canônica da API onde Better Auth expõe /api/auth/*.
# Exemplo: https://api.seu-dominio.com
BETTER_AUTH_URL=

# Origem pública permitida do aplicativo web, sem barra ao final.
# Usar futuramente na política de origem/CORS e na autenticação.
# Exemplo: https://folha.seu-dominio.com
WEB_ORIGIN=

# =================== apps/web (Next.js) ===================
# URL da API Hono consultada pelo servidor/rewrite Next.js.
# Exemplo: https://api.seu-dominio.com
# Ainda precisa ser integrada e validada com o roteamento.
API_INTERNAL_URL=

# Não criar NEXT_PUBLIC_DATABASE_URL, NEXT_PUBLIC_BETTER_AUTH_SECRET
# ou qualquer variável NEXT_PUBLIC_ contendo senha/token.
# A criação inicial da conta ADMIN ocorrerá por rotina segura e separada.
