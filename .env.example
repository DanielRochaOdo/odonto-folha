# OdontoFolha — modelo sem segredos
# Nunca coloque credenciais reais aqui, em commits, issues ou mensagens.
# Em produção, configure as variáveis no projeto Vercel. Services compartilha
# o escopo de variáveis entre os serviços.

# =================== API Hono ===================
# URL Neon POOLED (host normalmente contém -pooler). Uso no runtime da API.
DATABASE_URL=

# URL Neon DIRECT, sem -pooler: exclusivamente para migrations administrativas
# controladas, nunca no runtime da aplicação ou navegador.
DIRECT_URL=

# Gerar com "openssl rand -base64 32". Nunca usar senha do usuário ADMIN.
BETTER_AUTH_SECRET=

# Origem pública canônica do projeto que serve /api/auth/*.
# Com Web e API no mesmo domínio: https://odonto-folha.vercel.app
BETTER_AUTH_URL=

# Origem pública confiável do aplicativo Web, sem barra ao final.
# Usar a mesma origem de BETTER_AUTH_URL com domínio compartilhado.
WEB_ORIGIN=

# Opcional; habilita rotas de negócio somente após autorização operacional.
ODONTOFOLHA_API_REAL=

# =================== Desenvolvimento local ===================
# Opcional; destino do proxy de pnpm dev. Não configurar na Vercel:
# o roteamento Services encaminha /api/* para a API.
API_INTERNAL_URL=

# Não criar NEXT_PUBLIC_DATABASE_URL, NEXT_PUBLIC_BETTER_AUTH_SECRET
# ou qualquer NEXT_PUBLIC_ que contenha senha/token.
# A criação inicial da conta ADMIN ocorrerá por rotina segura e separada.
